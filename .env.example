# ---- server ----
PORT=3000
PUBLIC_URL=https://headcount.example.org
DATA_DIR=./data
# Set to 1 when a proxy or load balancer sits in front of the server.
TRUST_PROXY=0
NODE_ENV=production

# ---- sign-in: Google Cloud Identity Platform ----
# AUTH_MODE is firebase when the three values below are set, or none (no accounts).
# AUTH_MODE=dev is a local test sign-in and refuses to run with NODE_ENV=production.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Which sign-in buttons to show.
SIGNIN_PROVIDERS=google,microsoft

# ---- email: notifications, digests, invitations (optional) ----
# Any SMTP service. Percent-encode special characters in the password.
SMTP_URL=
EMAIL_FROM=Headcount <notifications@headcount.example.org>
# Signs unsubscribe links. openssl rand -hex 32
APP_SECRET=
# smtp (default when SMTP_URL is set), outbox (keep emails for testing), or off.
EMAIL_MODE=
# How often to check for digests that are due, in milliseconds.
DIGEST_INTERVAL_MS=600000

# ---- website ----
# off sends / straight to the app.
SITE=

# ---- bill lookup (optional) ----
CONGRESS_API_KEY=
OPENSTATES_API_KEY=

# ---- brief drafting with Claude (optional) ----
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=200

# ---- plans and billing with Stripe (optional; without these every workspace is unlimited) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_FIRM=
# Price text shown on the subscribe buttons, for example "$40 per seat per month".
PRICE_LABEL_TEAM=
PRICE_LABEL_FIRM=
# Shown on the website and to admins; also receives demo requests.
SALES_EMAIL=
TRIAL_DAYS=14
TRIAL_SEATS=10
