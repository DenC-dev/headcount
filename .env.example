# ---- server ----
PORT=3000
PUBLIC_URL=https://headcount.example.org
DATA_DIR=./data
# Set to 1 when a proxy or load balancer sits in front of the server.
TRUST_PROXY=0
NODE_ENV=production

# ---- sign-in: Google Cloud Identity Platform ----
# AUTH_MODE is firebase when the three values below are set, or none (no accounts).
# AUTH_MODE=dev is a local test sign-in and refuses to run with NODE_ENV=production.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Which sign-in buttons to show.
SIGNIN_PROVIDERS=google,microsoft

# ---- bill lookup (optional) ----
CONGRESS_API_KEY=
OPENSTATES_API_KEY=

# ---- brief drafting with Claude (optional) ----
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=200
